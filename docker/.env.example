# Copy to docker/.env (gitignored). Every visit needs a GitHub login; at least one of TP_ADMINS / TP_ORG is required.
# GitHub logins that may log in, comma separated. They are the admins (force logout, ...).
TP_ADMINS=
# Optional: members of this GitHub org may log in too.
TP_ORG=
# Host port, published on 127.0.0.1 only.
TP_PORT=3032
# Optional, public access (TP-166, README "외부 공개"): the Cloudflare Tunnel token, used by
# `docker compose --profile tunnel up -d`, and the https address its public hostname serves.
TUNNEL_TOKEN=
TP_PUBLIC_URL=
